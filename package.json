{
  "name": "localtasks-tasktracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "world:create": "bun run scripts/test-world/cli.ts",
    "build": "vite build && bun build server/index.ts --outfile build/server.js --target bun",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "bun test"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "openai": "^6.39.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^5.0.2",
    "bun-types": "^1.3.8",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.3.3"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "postcss": "8.5.14"
  }
}
